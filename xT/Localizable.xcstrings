        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fat distribution is stable. Diet and exercise affect body composition as they always did, in estrogen-dominant deposition patterns. Resistance training is associated with maintained bone density."
          }
        }
      }
    },
    "Fat redistribution is among the slowest changes, typically measured in years rather than months. Weight cycling can accelerate it, but redistribution proceeds without it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fat redistribution is among the slowest changes, typically measured in years rather than months. Weight cycling can accelerate it, but redistribution proceeds without it."
