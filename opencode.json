{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    },
    "sosumi": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://sosumi.ai/mcp"
      ],
      "enabled": true
    },
    "XcodeBuildMCP": {
      "type": "local",
      "command": ["npx", "-y", "xcodebuildmcp@latest", "mcp"],
      "enabled": true
    },
    "xcode": {
      "type": "local",
      "command": ["xcrun", "mcpbridge"],
      "enabled": true
    }
  }
}
